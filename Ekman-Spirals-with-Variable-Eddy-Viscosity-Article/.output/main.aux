\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The vertical structure of the momentum flux for the two layer model. The momentum flux is dependent on the dimensionless parameter $\varphi =H/h_\text  {Ek1}$ and the ratio of the viscosities. The corresponding Ekman heights and interface are shown with the vertical momentum flux. The solution assumed a purely zonal geostrophic flow $U_g=\SI {10}{\meter \per \second }$, a Coriolis parameter of $f=\SI {1e-4}{\per \second }$ and an intersection height of $H=\SI {100}{\meter }$. The lower viscosities, derived from $H$ and $\varphi $, are $\nu _1=\SI {2e0}{\meter ^2\per \second }$, $\nu _1=\SI {5e-1}{\meter ^2\per \second }$, and $\nu _1=\SI {2.22e-1}{\meter ^2\per \second }$ in both figures. In the left figure, $\nu _2$ used half the value of the lower viscosities, and in the right figure, it used double of that value.}}{5}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:2layer_structure}{{1}{5}{The vertical structure of the momentum flux for the two layer model. The momentum flux is dependent on the dimensionless parameter $\varphi =H/h_\text {Ek1}$ and the ratio of the viscosities. The corresponding Ekman heights and interface are shown with the vertical momentum flux. The solution assumed a purely zonal geostrophic flow $U_g=\SI {10}{\meter \per \second }$, a Coriolis parameter of $f=\SI {1e-4}{\per \second }$ and an intersection height of $H=\SI {100}{\meter }$. The lower viscosities, derived from $H$ and $\varphi $, are $\nu _1=\SI {2e0}{\meter ^2\per \second }$, $\nu _1=\SI {5e-1}{\meter ^2\per \second }$, and $\nu _1=\SI {2.22e-1}{\meter ^2\per \second }$ in both figures. In the left figure, $\nu _2$ used half the value of the lower viscosities, and in the right figure, it used double of that value}{figure.caption.6}{}}
\newlabel{eq:2layerAngle}{{21}{5}{The two layer model}{equation.2.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The surface angle as a function of the dimensionless layer thickness $\varphi = H/h_\text  {Ek1}$ for the two-layer model. Different coloured curves correspond to different layer viscosity ratios. The classical Ekman angle of \ang {45} is shown as a reference.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:2layer_angle}{{2}{6}{The surface angle as a function of the dimensionless layer thickness $\varphi = H/h_\text {Ek1}$ for the two-layer model. Different coloured curves correspond to different layer viscosity ratios. The classical Ekman angle of \ang {45} is shown as a reference}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}The exponential decaying viscosity model}{6}{subsection.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The vertical spiral of the velocities for the two layer model together with the corresponding Ekman heights. The wind direction is dependent on the dimensionless parameter $\varphi = H/h_\text  {Ek1}$. The classical Ekman solution (when $\nu _\text  {const}=\nu _1$) is shown as a reference. The parameters used the same values as in \autoref {fig:2layer_structure}.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:2_layer_angle_structure}{{3}{7}{The vertical spiral of the velocities for the two layer model together with the corresponding Ekman heights. The wind direction is dependent on the dimensionless parameter $\varphi = H/h_\text {Ek1}$. The classical Ekman solution (when $\nu _\text {const}=\nu _1$) is shown as a reference. The parameters used the same values as in \autoref {fig:2layer_structure}}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The total transport as a function of the dimensionless layer thickness $\varphi = H/h_\text  {Ek1}$ for the two-layer model. Different coloured curves correspond to different layer viscosity ratios. The solution assumed $\nu _1=\SI {0.01}{\meter \squared \per \second }$.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:2layer_transport}{{4}{7}{The total transport as a function of the dimensionless layer thickness $\varphi = H/h_\text {Ek1}$ for the two-layer model. Different coloured curves correspond to different layer viscosity ratios. The solution assumed $\nu _1=\SI {0.01}{\meter \squared \per \second }$}{figure.caption.9}{}}
\newlabel{eq:exponetial}{{30}{8}{The exponential decaying viscosity model}{equation.2.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The vertical structure of the momentum flux for exponentially decreasing viscosity together with the corresponding Ekman height and inverse decay rate. The momentum flux is dependent on the dimensionless parameter $\varphi _\text  {exp}=1/k\,h_\text  {Ek0}$. The solution assumed a purely zonal geostrophic flow $U_g=\SI {10}{\meter \per \second }$, a Coriolis parameter of $f=\SI {1e-4}{\per \second }$, a decay rate of $k=\SI {1e-02}{\per \meter }$ and initial viscosities of $\nu _0=\SI {12.5}{\per \meter }$, $\nu _0=\SI {0.5}{\per \meter }$ and $\nu _0=\SI {0.03125}{\per \meter }$. }}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:exponential_structure}{{5}{8}{The vertical structure of the momentum flux for exponentially decreasing viscosity together with the corresponding Ekman height and inverse decay rate. The momentum flux is dependent on the dimensionless parameter $\varphi _\text {exp}=1/k\,h_\text {Ek0}$. The solution assumed a purely zonal geostrophic flow $U_g=\SI {10}{\meter \per \second }$, a Coriolis parameter of $f=\SI {1e-4}{\per \second }$, a decay rate of $k=\SI {1e-02}{\per \meter }$ and initial viscosities of $\nu _0=\SI {12.5}{\per \meter }$, $\nu _0=\SI {0.5}{\per \meter }$ and $\nu _0=\SI {0.03125}{\per \meter }$}{figure.caption.10}{}}
\newlabel{eq:ExponetialAngle}{{31}{8}{The exponential decaying viscosity model}{equation.2.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Surface angle for the exponentially decaying viscosity model as a function of the dimensionless parameter $\varphi _\text  {exp}=H/h_\text  {Ek0}$. The same parameters as in \autoref {fig:exponential_structure} was used.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:exponential_angle}{{6}{9}{Surface angle for the exponentially decaying viscosity model as a function of the dimensionless parameter $\varphi _\text {exp}=H/h_\text {Ek0}$. The same parameters as in \autoref {fig:exponential_structure} was used}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The vertical spiral for the exponentially decreasing viscosity model together with the Ekman height and the inverse decay rate. The wind direction is dependent on the dimensionless parameter $\varphi _\text  {exp}=1/k\,h_\text  {Ek0}$. The classical Ekman solution (for $\nu _0$) is shown as a reference. The parameters had the same values as in \autoref {fig:exponential_structure}.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:exponential_angle_structure}{{7}{9}{The vertical spiral for the exponentially decreasing viscosity model together with the Ekman height and the inverse decay rate. The wind direction is dependent on the dimensionless parameter $\varphi _\text {exp}=1/k\,h_\text {Ek0}$. The classical Ekman solution (for $\nu _0$) is shown as a reference. The parameters had the same values as in \autoref {fig:exponential_structure}}{figure.caption.12}{}}
